{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["icn1"],
  "functions": {
    "api/cms.js": { "maxDuration": 60 }
  },
  "git": {
    "deploymentEnabled": { "cms-state": false }
  }
}
